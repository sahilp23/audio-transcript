# Copy to .env and edit. All settings are optional.

# Free Hugging Face token for speaker separation (see README)
# HF_TOKEN=hf_xxx

# Speech model. large-v3-turbo is the best speed/accuracy trade-off on an M2.
# MLX_MODEL=mlx-community/whisper-large-v3-turbo

# Where calls are stored (default: ./data)
# CONCALL_DATA_DIR=~/Concalls

# Local AI summaries via Ollama
# OLLAMA_MODEL=llama3.2:3b

# PORT=8765
